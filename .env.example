# Copy this file to .env and fill in DISCORD_TOKEN. Everything else has working defaults.

# Required: Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Recommended: comma-separated server IDs, so slash commands show up instantly there.
# (Discord: Settings -> Advanced -> Developer Mode, then right-click your server -> Copy Server ID)
# Leave empty to register commands globally in every server the bot is in.
GUILD_IDS=

# Lavalink, the local audio server the bot starts for you
LAVALINK_PASSWORD=change-me
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_AUTOSTART=true
# Only needed if Java 17+ isn't found automatically, e.g. C:\Program Files\Eclipse Adoptium\jre-21...\bin\java.exe
JAVA_PATH=

# Playback
DEFAULT_VOLUME=80
MAX_QUEUE_SIZE=500
# Seconds before leaving the voice channel when nothing is playing / when nobody else is in it
IDLE_TIMEOUT=180
EMPTY_CHANNEL_TIMEOUT=60

# Apple Music: the access token is fetched automatically. Set a token only if that stops working (see README).
APPLE_MUSIC_COUNTRY=US
APPLE_MUSIC_MEDIA_TOKEN=

# YouTube sign-in: only needed if YouTube starts refusing playback with "Sign in to confirm you're not a bot".
# See README -> Troubleshooting. Use a spare Google account, never your main one.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=
