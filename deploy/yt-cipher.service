# systemd service for yt-cipher (https://github.com/kikkia/yt-cipher), installed by
# `deploy/setup-server.sh --with-cipher`. It decodes YouTube stream signatures for Lavalink on
# cloud servers. /home/voldemar/yt-cipher.env sets HOST=127.0.0.1 (not reachable from outside),
# PORT and the API_TOKEN password.
[Unit]
Description=yt-cipher (YouTube signature decoding for Lavalink)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=voldemar
Group=voldemar
WorkingDirectory=/home/voldemar/yt-cipher
EnvironmentFile=/home/voldemar/yt-cipher.env
ExecStart=/home/voldemar/.deno/bin/deno run --allow-net --allow-read --allow-write --allow-env server.ts
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
